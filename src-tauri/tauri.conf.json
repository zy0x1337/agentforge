{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentForge",
  "version": "0.1.0",
  "identifier": "dev.agentforge.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "AgentForge",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Browse local LLMs and orchestrate agent workflows on Windows",
    "longDescription": "AgentForge lets you browse, download and manage open-source LLMs via Ollama, then build automated multi-agent workflows defined by Markdown files. Agents activate each other, pass context forward, and run sequentially or in parallel — all locally, no cloud required.",
    "copyright": "Copyright © 2026 AgentForge Contributors",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "homepage": "https://github.com/zy0x1337/agentforge",
    "category": "DeveloperTool",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "headerImage": "../assets/installer/nsis-header.bmp",
        "sidebarImage": "../assets/installer/nsis-sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      },
      "wix": {
        "language": "en-US",
        "upgradeCode": "5F3B2A1C-9D4E-4F7A-B8C6-2E0A1D3F5B7C"
      }
    },
    "publisher": "AgentForge Contributors",
    "resources": []
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "http": {
      "scope": [
        "http://localhost:11434/**",
        "https://ollama.com/**",
        "https://huggingface.co/**",
        "https://raw.githubusercontent.com/**"
      ]
    }
  }
}
