{
  "name": "agentforge",
  "version": "0.1.0",
  "description": "Browse local open-source LLMs and orchestrate Markdown-defined agent workflows — native desktop app for Windows, macOS and Linux",
  "author": "AgentForge Contributors",
  "homepage": "https://github.com/zy0x1337/agentforge",
  "repository": {
    "type": "git",
    "url": "https://github.com/zy0x1337/agentforge.git"
  },
  "license": "MIT",
  "keywords": [
    "llm",
    "ai-agents",
    "ollama",
    "workflow",
    "tauri",
    "desktop",
    "local-ai"
  ],
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "^2",
    "@tauri-apps/plugin-http": "^2",
    "@tauri-apps/plugin-shell": "^2",
    "@tauri-apps/plugin-store": "^2",
    "@xyflow/react": "^12",
    "dagre": "^0.8.5",
    "dompurify": "^3",
    "gray-matter": "^4",
    "marked": "^12",
    "react": "^18",
    "react-dom": "^18",
    "zustand": "^4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/dagre": "^0.7.3",
    "@types/dompurify": "^3",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "@vitejs/plugin-react": "^4",
    "@vitest/coverage-v8": "^2",
    "eslint": "^8",
    "eslint-plugin-react-hooks": "^4",
    "eslint-plugin-react-refresh": "^0.4",
    "typescript": "^5",
    "vite": "^5",
    "vitest": "^2"
  }
}
